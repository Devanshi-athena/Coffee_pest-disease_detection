# Keep LF everywhere: the training notebook verifies SHA256 checksums of ml/src/*.py,
# so a Windows checkout must not rewrite line endings.
* text=auto eol=lf
*.png binary
*.jpg binary
*.onnx binary
*.npz binary
*.zip binary
# These two were checksummed by the training notebook with CRLF endings: store them byte-for-byte.
ml/src/export_onnx.py -text
ml/src/phase2.py -text
